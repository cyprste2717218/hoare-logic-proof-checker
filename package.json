{
  "name": "hoare-logic-proof-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "xo --prettier src/**/*.{ts,tsx}",
    "lint-fix": "xo --prettier src/**/*.{ts,tsx} --fix",
    "nuke": "npm run delete-pkgs && npm run clean-cache && npm install || exit 1 && npm run build",
    "delete-pkgs": "rimraf node_modules dist",
    "clean-cache": "npm cache clean --force",
    "preview": "vite preview",
    "prepare": "husky install",
    "test": "npm run test:unit && npm run test:it && npm run test:end",
    "test:unit": "jest --testMatch \"**/*.unit.test.ts\"",
    "test:it": "jest --testMatch \"**/*.it.test.ts\"",
    "test:e2e": "jest --testMatch \"**/*.e2e.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.482.0",
    "radix-ui": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.14",
    "tailwindcss-animate": "^1.0.7",
    "z3-solver": "^4.14.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.21.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint": "^19.8.0",
    "cypress": "^14.2.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "xo": "^0.60.0"
  },
  "xo": {
    "rules": {
      "unicorn/expiring-todo-comments": "off",
      "unicorn/filename-case": "off",
      "import/extensions": "off",
      "@typescript-eslint/extension-rule": "off",
      "n/file-extension-in-import": "off",
      "unicorn/prevent-abbreviations": "off"
    },
    "ignores": [
      "**/*.d.ts",
      "./src/main.tsx"
    ]
  }
}